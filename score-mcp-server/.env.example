# Score MCP Server Configuration
# Copy this file to .env and update with your actual values

# =============================================================================
# Database Configuration
# =============================================================================

# Option 1: Full Connection String (Recommended)
# If DATABASE_URL is set, individual DATABASE_* variables below are ignored
DATABASE_URL=mariadb+mariadbconnector://user:password@host:port/database

# Option 2: Individual Components (used if DATABASE_URL is not set)
# DATABASE_CONNECTOR=mariadb+mariadbconnector
# DATABASE_HOSTNAME=127.0.0.1
# DATABASE_PORT=3306
# DATABASE_USERNAME=root
# DATABASE_PASSWORD=
# DATABASE_NAME=

# =============================================================================
# Authentication Configuration
# =============================================================================

# Authentication provider class path (e.g., fastmcp.server.auth.oidc_proxy.OIDCProxy)
# If not set, authentication is disabled
# AUTH_PROVIDER=fastmcp.server.auth.oidc_proxy.OIDCProxy

# OIDC/OAuth2 Configuration
# AUTH_PROVIDER_PARAMS_CONFIG_URL=https://your-oidc-provider.com/.well-known/openid-configuration
# AUTH_PROVIDER_PARAMS_CLIENT_ID=your_client_id
# AUTH_PROVIDER_PARAMS_CLIENT_SECRET=your_client_secret
# AUTH_PROVIDER_PARAMS_AUDIENCE=https://your-oidc-provider.com/api/v2/
# AUTH_PROVIDER_PARAMS_BASE_URL=http://localhost:8000

# =============================================================================
# Server Configuration
# =============================================================================

# Host address to bind the server to
# 0.0.0.0 = all interfaces, 127.0.0.1 = localhost only
HOST=0.0.0.0

# Port number to listen on
PORT=8000

# Number of uvicorn worker processes (only used in Docker/startup scripts)
WORKERS=4

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable stateless HTTP mode (required for Docker/containerized deployments)
# If CORS is enabled, this is automatically set to true
STATELESS_HTTP=true

# =============================================================================
# SQLAlchemy Logging Configuration (Optional)
# =============================================================================

# Enable SQLAlchemy query logging
# Set to true, 1, yes, or on to enable SQL query logging
# Useful for debugging database queries and performance analysis
# SQLALCHEMY_LOG=false

# Log level for SQLAlchemy loggers (defaults to LOG_LEVEL if not set)
# Valid values: DEBUG, INFO, WARNING, ERROR, CRITICAL
# SQLALCHEMY_LOG_LEVEL=INFO (defaults to LOG_LEVEL if not set)

# =============================================================================
# CORS Configuration (Optional)
# =============================================================================

# Enable CORS (Cross-Origin Resource Sharing) middleware
# CORS_ENABLED=false

# Allowed origins (comma-separated list or * for all origins)
# CORS_ALLOW_ORIGINS=*

# Allowed HTTP methods (comma-separated list or * for all methods)
# CORS_ALLOW_METHODS=*

# Allowed HTTP headers (comma-separated list or * for all headers)
# CORS_ALLOW_HEADERS=*

# Exposed HTTP headers (comma-separated list or * for all headers)
# CORS_EXPOSE_HEADERS=*

# Allow credentials (cookies, authorization headers) in CORS requests
# CORS_ALLOW_CREDENTIALS=false

# Maximum age (in seconds) for preflight OPTIONS request caching
# CORS_MAX_AGE=600

# =============================================================================
# Cache Configuration
# =============================================================================

# Cache type: memory (or inmemory) for in-memory cache, redis for Redis cache
# CACHE_TYPE=memory

# InMemoryCache Settings (only used when CACHE_TYPE=memory)
# Maximum number of cache entries before LRU eviction
# CACHE_MAX_SIZE=1000

# Default TTL (Time To Live) in seconds for cache entries
# CACHE_DEFAULT_TTL=60

# RedisCache Settings (only used when CACHE_TYPE=redis)
# Redis Cache connection URL
# Examples:
#   - Single instance: redis://localhost:6379/0
#   - With password: redis://:password@redis.example.com:6379/1
#   - Sentinel: redis+sentinel://:password@host:port/0?master=master_name
#   - Cluster: redis-cluster://:password@host:port
# REDIS_CACHE_URL=redis://localhost:6379/0

# Redis deployment type: single, sentinel, or cluster
# If not set, will be auto-detected from REDIS_CACHE_URL scheme
# REDIS_CACHE_TYPE=single

# Redis Sentinel Configuration (only used when CACHE_TYPE=redis and REDIS_CACHE_TYPE=sentinel)
# Master name for Sentinel mode
# REDIS_CACHE_SENTINEL_MASTER=mymaster

# Comma-separated list of Sentinel node addresses
# Format: host1:port1,host2:port2,host3:port3
# REDIS_CACHE_SENTINEL_NODES=sentinel1.example.com:26379,sentinel2.example.com:26379,sentinel3.example.com:26379

# Redis Cluster Configuration (only used when CACHE_TYPE=redis and REDIS_CACHE_TYPE=cluster)
# Comma-separated list of Cluster node addresses
# Format: host1:port1,host2:port2,host3:port3
# REDIS_CACHE_CLUSTER_NODES=cluster1.example.com:6379,cluster2.example.com:6379,cluster3.example.com:6379
